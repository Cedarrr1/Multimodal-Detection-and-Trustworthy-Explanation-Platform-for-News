{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage2RelationV3Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "overall_relation"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim",
          "visual_verifiability",
          "relation",
          "visual_evidence",
          "evidence_attributes"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "visual_verifiability": {
            "type": "string",
            "enum": ["verifiable", "not_verifiable"]
          },
          "relation": {
            "type": "string",
            "enum": ["supports", "contradicts", "unrelated", "insufficient"]
          },
          "visual_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_attributes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "enum": [
                "person",
                "gender",
                "age",
                "eyewear",
                "facial_hair",
                "hair_color",
                "hair_length",
                "headwear",
                "clothing",
                "color",
                "object",
                "count",
                "scene",
                "background",
                "action",
                "expression",
                "ocr",
                "spatial",
                "identity",
                "time",
                "causality",
                "event_truth",
                "viewpoint"
              ]
            }
          }
        }
      }
    },
    "overall_relation": {
      "type": "string",
      "enum": ["supports", "contradicts", "unrelated", "insufficient"]
    }
  }
}
