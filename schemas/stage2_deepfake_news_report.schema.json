{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage2DeepfakeNewsReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_verdict",
    "tamper_domain",
    "text_image_relation",
    "final_news_verdict",
    "forensic_region",
    "evidence"
  ],
  "properties": {
    "image_verdict": {
      "type": "string",
      "enum": ["authentic", "tampered"]
    },
    "tamper_domain": {
      "type": "string",
      "enum": ["none", "deepfake"]
    },
    "text_image_relation": {
      "type": "string",
      "enum": ["consistent", "mismatched"]
    },
    "final_news_verdict": {
      "type": "string",
      "enum": ["credible", "fake_news"]
    },
    "forensic_region": {
      "type": "string",
      "enum": ["face", "none"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 5
    }
  }
}
